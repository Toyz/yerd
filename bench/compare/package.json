{
  "name": "yerd-bench-compare",
  "private": true,
  "description": "Benchmarks yerd against other Node frameworks. A separate package, so competitors never become dependencies of yerd itself.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.nest.json",
    "bench": "npm run build && node run.mjs"
  },
  "dependencies": {
    "@toyz/yerd": "file:../..",
    "@hono/node-server": "2.1.5",
    "@koa/bodyparser": "6.1.0",
    "@koa/router": "15.7.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "autocannon": "8.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "hono": "4.13.13",
    "koa": "3.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/koa": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2"
  }
}
