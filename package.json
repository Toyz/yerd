{
  "name": "@toyz/yerd",
  "version": "0.2.1",
  "description": "A TypeScript web server where routes are decorated classes and TSX is the template engine. Zero runtime dependencies.",
  "keywords": [
    "web",
    "server",
    "framework",
    "decorators",
    "tsx",
    "jsx",
    "ssr",
    "typescript",
    "zero-dependency"
  ],
  "type": "module",
  "license": "MIT",
  "author": "toyz",
  "homepage": "https://github.com/Toyz/yerd#readme",
  "bugs": {
    "url": "https://github.com/Toyz/yerd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toyz/yerd.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx/jsx-runtime.d.ts",
      "import": "./dist/src/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/src/jsx/jsx-dev-runtime.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "node": "./dist/src/client/server.js",
      "default": "./dist/src/client/index.js"
    },
    "./vite": {
      "types": "./dist/src/vite/index.d.ts",
      "import": "./dist/src/vite/index.js"
    },
    "./auth": {
      "types": "./dist/src/auth/index.d.ts",
      "import": "./dist/src/auth/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist/src',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p . --noEmit",
    "test": "vitest run",
    "dev": "vite --config examples/hello/vite.config.ts",
    "example": "npm run dev",
    "example:raw": "tsc -p tsconfig.examples.json && node dist/examples/hello/src/server.js",
    "todo": "vite --config examples/todo/vite.config.ts",
    "todo:raw": "tsc -p tsconfig.examples.json && node dist/examples/todo/src/server.js",
    "e2e": "playwright test",
    "screenshots": "node test/e2e/screenshots.mjs",
    "tailwind": "vite --config examples/tailwind/vite.config.ts",
    "kitchen": "vite --config examples/kitchen-sink/vite.config.ts",
    "todo:build": "vite build --config examples/todo/vite.config.ts",
    "todo:start": "node examples/todo/dist/server/server.js",
    "bench": "tsc -p tsconfig.bench.json && node bench/run.mjs",
    "prepublishOnly": "npm run build && npm run check && npm test"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "esbuild": ">=0.25.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "autocannon": "^8.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
